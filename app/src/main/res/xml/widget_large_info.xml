<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2, resizable: counters and the latest mentions. Updated by the app after each sync; the
     system's half-hourly update only moves the time on -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_large_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="220dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_large_preview_image"
    android:previewLayout="@layout/widget_large_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
